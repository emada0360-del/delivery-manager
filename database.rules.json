      "$uid": {
        ".write": "auth != null&&auth.uid===$uid&&root.child('users').child(auth.uid).child('role').val()==='driver'&&root.child('users').child(auth.uid).child('isActive').val()!==false",
        ".validate": "newData.hasChildren(['lat','lng','t'])&&newData.child('lat').isNumber()&&newData.child('lng').isNumber()"
      }
    },
    "tracking": {
      "$orderId": {
        ".read": "auth != null&&(root.child('users').child(auth.uid).child('role').val()==='admin'||root.child('customerOrders').child($orderId).child('customerId').val()===auth.uid||root.child('orders').child($orderId).child('storeId').val()===auth.uid)",
        ".write": "auth != null&&(root.child('users').child(auth.uid).child('role').val()==='admin'||(root.child('users').child(auth.uid).child('role').val()==='driver'&&root.child('orders').child($orderId).child('driverId').val()===auth.uid))",
        ".validate": "newData.hasChildren(['lat','lng','t','driverId'])&&newData.child('lat').isNumber()&&newData.child('lng').isNumber()"
      }
    },
    "refunds": {
      ".read": "auth != null&&root.child('users').child(auth.uid).child('role').val()==='admin'",
      "$id": {
        ".read": "auth != null&&data.child('driverId').val()===auth.uid",
        ".write": "auth != null&&(root.child('users').child(auth.uid).child('role').val()==='admin'||(!data.exists()&&newData.child('driverId').val()===auth.uid&&root.child('users').child(auth.uid).child('role').val()==='driver'&&root.child('orders').child($id).child('driverId').val()===auth.uid&&root.child('orders').child($id).child('status').val()==='delivered'&&newData.child('status').val()==='pending'))",
        ".validate": "newData.hasChildren(['amount','driverId','status','createdAt'])&&newData.child('amount').isNumber()&&newData.child('amount').val()>0&&newData.child('amount').val()<=500000"
      }
    },
    "driverHistory": {
      ".read": "auth != null&&root.child('users').child(auth.uid).child('role').val()==='admin'",
      "$uid": {
        ".read": "auth != null&&auth.uid===$uid",
        ".write": "auth != null&&root.child('users').child(auth.uid).child('role').val()==='admin'"
      }
    }
  }
}
